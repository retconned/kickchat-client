{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!examples/basic-bot.ts",
      "!examples/harvest-credentials.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noVoidTypeReturn": "warn",
        "noUndeclaredVariables": "warn"
      },
      "complexity": {
        "noBannedTypes": "warn",
        "noStaticOnlyClass": "warn",
        "useOptionalChain": "warn",
        "noUselessConstructor": "warn",
        "noUselessSwitchCase": "warn",
        "noUselessUndefined": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImplicitAnyLet": "warn",
        "noConfusingVoidType": "warn",
        "noAsyncPromiseExecutor": "warn",
        "noGlobalIsNan": "warn",
        "noVar": "warn",
        "noThenProperty": "warn",
        "useAwait": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "warn",
        "useErrorCause": "error",
        "useImportType": {
          "level": "warn",
          "options": {
            "style": "inlineType"
          }
        },
        "noUselessElse": "warn",
        "useTemplate": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useThrowOnlyError": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn"
      },
      "security": {
        "noGlobalEval": "warn"
      },
      "nursery": {
        "noMisusedPromises": "error"
      }
    }
  }
}
