{
  "name": "@retconned/kick-js",
  "version": "0.8.0",
  "description": "A typescript bot interface for kick.com",
  "keywords": [
    "Kick.com",
    "Kick Streaming",
    "Livestream",
    "Kick Chat",
    "Kick Bot",
    "Kick Api",
    "Kick Api Wrapper",
    "Kick library"
  ],
  "homepage": "https://github.com/retconned/kick-js",
  "bugs": {
    "url": "https://github.com/retconned/kick-js/issues"
  },
  "author": "retconned <retcnned@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retconned/kick-js.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "format": "biome format --write .",
    "lint": "biome check",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "check-exports": "attw --pack .",
    "dev": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "checks": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check-exports",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "release:local": "pnpm checks && pnpm release:version && pnpm release:publish"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "ws": "^8.18.0"
  }
}
